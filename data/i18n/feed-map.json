{
  "schema_version": "1.0",
  "description": "Source registry and locale policy for Mia dynamic feeds. English endpoints are planned until the source publishes reviewed English payloads.",
  "feeds": {
    "daily_note": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/daily.json",
      "collection_key": null,
      "identity": "date",
      "source_locale": "zh-CN",
      "english_payload": "translations.en",
      "english_status_required": "published",
      "english_endpoint": null
    },
    "philosophy": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/todays-philosophy.json",
      "collection_key": null,
      "identity": "date",
      "source_locale": "zh-CN",
      "english_payload": "translations.en",
      "english_status_required": "published",
      "english_endpoint": null
    },
    "zhi_sections": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/sections.json",
      "collection_key": "sections",
      "identity": "sections[].id",
      "source_locale": "zh-CN",
      "english_payload": "sections[].translations.en",
      "english_status_required": "published",
      "english_endpoint": null
    }
  },
  "policy": {
    "cross_locale_fallback": false,
    "unreviewed_translation_publication": false,
    "source_mutation_during_localization": false
  }
}