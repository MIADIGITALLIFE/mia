{
  "schema_version": "1.0",
  "description": "Source registry for automatic Chinese-to-English feeds. English feeds are published by the ZEE/Supabase translation pipeline.",
  "feeds": {
    "daily_note": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/daily.json",
      "collection_key": null,
      "identity": "date",
      "source_locale": "zh-CN",
      "english_payload": "translations.en",
      "english_status_required": "published",
      "english_endpoint": "https://raw.githubusercontent.com/MIADIGITALLIFE/zee/main/mia/en/daily.json"
    },
    "philosophy": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/todays-philosophy.json",
      "collection_key": null,
      "identity": "date",
      "source_locale": "zh-CN",
      "english_payload": "translations.en",
      "english_status_required": "published",
      "english_endpoint": "https://raw.githubusercontent.com/MIADIGITALLIFE/zee/main/mia/en/todays-philosophy.json"
    },
    "zhi_sections": {
      "source": "https://raw.githubusercontent.com/ZEEFSEE/ZEE/main/mia/sections.json",
      "collection_key": "sections",
      "identity": "sections[].id",
      "source_locale": "zh-CN",
      "english_payload": "sections[].translations.en",
      "english_status_required": "published",
      "english_endpoint": "https://raw.githubusercontent.com/MIADIGITALLIFE/zee/main/mia/en/sections.json"
    }
  },
  "policy": {
    "cross_locale_fallback": false,
    "unreviewed_translation_publication": true,
    "source_mutation_during_localization": false,
    "automated_quality_gate_required": true
  }
}
